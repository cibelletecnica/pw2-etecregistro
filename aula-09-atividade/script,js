const inputN1 = document.querySelector('input#n1');
const inputN2 = document.querySelector('input#n2');
const resultado = document.querySelector('div#resultado');

function somar() {
    const n1 = Number(inputN1.value);
    const n2 = Number(inputN2.value);

    const soma = n1 + n2;

    resultado.innerHTML = `♡ Resultado: ${soma} ♡`;
}

function subtrair() {
    const n1 = Number(inputN1.value);
    const n2 = Number(inputN2.value);

    const subtracao = n1 - n2;

    resultado.innerHTML = `♡ Resultado: ${subtracao} ♡`;
}

function multiplicar() {
    const n1 = Number(inputN1.value);
    const n2 = Number(inputN2.value);

    const multiplicacao = n1 * n2;

    resultado.innerHTML = `♡ Resultado: ${multiplicacao} ♡`;
}

function dividir() {
    const n1 = Number(inputN1.value);
    const n2 = Number(inputN2.value);

    if (n2 === 0) {
        resultado.innerText = "୨୧ Não é possível dividir por 0! ୨୧";
    } else {
        const divisao = n1 / n2;
        resultado.innerHTML = `♡ Resultado: ${divisao} ♡`;
    }
}

function limpar() {
    inputN1.value = "";
    inputN2.value = "";
    resultado.innerHTML = "୨୧ O resultado aparecerá aqui ୨୧";
}

